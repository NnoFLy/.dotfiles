{
  "lastChangelogVersion": "0.99.1",
  "theme": "dark",
  "quietStartup": true,
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "externalEditor": "emacsclient --reuse-frame --alternate-editor=emacs",
  "defaultProvider": "openai-codex",
  "packages": [
    "npm:@pi-lab/notify",
    "npm:pi-web-access",
    "npm:pi-simplify",
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-subagents",
    "npm:@sreetej510/pi-usage"
  ],
  "hideThinkingBlock": true,
  "outputPad": 0,
  "treeFilterMode": "no-tools",
  "autocompleteMaxVisible": 8,
  "terminal": {
    "showImages": false
  }
}
