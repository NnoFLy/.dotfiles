font-size = 16

# font-family = "DepartureMono Nerd Font Mono"
# font-family = "FantasqueSansM Nerd Font"
font-family = "Maple Mono"
# font-family = "Aajohan Comfortaa"
# font-family = "GohuFont 11 Nerd Font Mono"
font-style = "Regular"
adjust-cell-height = 2

shell-integration-features = no-cursor

background-opacity = 0.7
background = "#000000"
maximize = true

window-padding-balance = true
window-padding-color = extend-always
window-decoration = none

confirm-close-surface = false

gtk-titlebar = false

keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+l=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+r=unbind
keybind = ctrl+shift+y=unbind
keybind = ctrl+alt+l=unbind
keybind = ctrl+tab=unbind
# keybind = ctrl+tab=unbind
# keybind = ctrl+shift+p=unbind
# keybind = ctrl+shift+n=unbind
keybind = ctrl+alt+l=unbind

keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right

