{
  "hooks": {
    "Notification": [
      {
        "matcher": "ToolPermission",
        "hooks": [
          {
            "name": "notify-approval",
            "type": "command",
            "command": "bash /home/nnofly/.dotfiles/scripts/gemini-notify 'Gemini CLI' 'Action required: Waiting for approval...'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "notify-complete",
            "type": "command",
            "command": "bash /home/nnofly/.dotfiles/scripts/gemini-notify 'Gemini CLI' 'Session tasks complete'"
          }
        ]
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "footer": {
      "items": [
        "workspace",
        "git-branch",
        "sandbox",
        "model-name",
        "quota",
        "context-used",
        "code-changes",
        "token-count"
      ]
    },
    "theme": "Solarized Dark"
  },
  "general": {
    "vimMode": false
  }
}